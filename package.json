{
  "name": "dsh-balance-widget",
  "version": "0.1.0",
  "description": "Web GUI floating widget that periodically queries the DeepSeek account balance",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test:standalone": "node test/standalone.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "balance"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
